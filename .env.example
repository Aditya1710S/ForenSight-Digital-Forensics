# Copy to .env  (PowerShell: Copy-Item .env.example .env)
HOST=127.0.0.1
PORT=3000
MAX_UPLOAD_MB=100
# Extra Host header values to accept (comma separated). Localhost is always accepted.
ALLOWED_HOSTS=
DEMO_MODE=false
DEFAULT_ACTOR=local-investigator
# Optional: full paths if the tools are not on PATH, e.g. C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
EXIFTOOL_PATH=exiftool
PROCESS_TIMEOUT_MS=60000
MAX_CONCURRENT_JOBS=2
MAX_CONTACT_SHEET_FRAMES=12
# Optional overrides
# STORAGE_DIR=storage
# DB_PATH=database/forensight.db
